{
  "name": "smart-money-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:start": "npm --prefix apps/web run start",
    "partner:dev": "npm --prefix services/partner_service run dev",
    "partner:build": "npm --prefix services/partner_service run build",
    "partner:start": "npm --prefix services/partner_service run start"
  }
}
